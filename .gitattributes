# Auto-detect line endings
* text=auto

# Shell scripts must use LF
*.sh text eol=lf
*.py text eol=lf

# HTML/CSS/JS
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# Plists and XML — keep as-is
*.plist text eol=lf
*.xml   text eol=lf

# Binary files
*.dmg  binary
*.icns binary
*.png  binary
*.jpg  binary
