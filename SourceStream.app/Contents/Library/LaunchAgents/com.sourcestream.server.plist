<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
    SourceStream LaunchAgent — stamped by the launcher on first boot.
    Placeholders below are replaced at install/first-run time:
        __PYTHON__    → /opt/homebrew/bin/python3  (or /usr/bin/python3)
        __SERVER_PY__ → /Applications/SourceStream.app/Contents/Resources/server.py
        __RES_DIR__   → /Applications/SourceStream.app/Contents/Resources
        __LOGS_DIR__  → /Users/<name>/.sourcestream/logs
    -->
    <key>Label</key>
    <string>com.sourcestream.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__SERVER_PY__</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__RES_DIR__</string>

    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>

    <key>StandardOutPath</key>
    <string>__LOGS_DIR__/server.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGS_DIR__/server.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
